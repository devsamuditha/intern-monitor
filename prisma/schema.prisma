datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  INTERN
  TECH_LEAD
  MANAGER
  SUPER_ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum MistakeSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNED
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  subscriptionPlan SubscriptionPlan @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users            User[]
  projects         Project[]
  dailyLogs        DailyLog[]
  tasks            Task[]
  marks            Mark[]
  mistakes         Mistake[]
  messages         Message[]
  questions        Question[]
  replies          Reply[]
  daySessions      DaySession[]
  auditLogs        AuditLog[]
  systemSettings   SystemSetting[]
  contentFlags     ContentFlag[]
  calendarMarkers  UserCalendarMarker[]
}

model User {
  id                String    @id @default(uuid())
  organizationId    String?   // Nullable for Super Admins
  name              String
  email             String    @unique
  username          String    @unique
  passwordHash      String
  mustChangePassword Boolean  @default(true)
  role              Role
  avatarUrl         String
  techLeadId        String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Self-relation: Tech Lead has many Interns
  techLead         User?     @relation("TechLeadInterns", fields: [techLeadId], references: [id], onDelete: SetNull)
  interns          User[]    @relation("TechLeadInterns")

  // Relationships
  projects         Project[] @relation("ProjectOwner")
  dailyLogs        DailyLog[]
  assignedTasks    Task[]    @relation("TaskAssignedTo")
  createdTasks     Task[]    @relation("TaskAssignedBy")
  receivedMarks    Mark[]    @relation("MarkIntern")
  givenMarks       Mark[]    @relation("MarkGivenBy")
  flaggedMistakes  Mistake[] @relation("MistakeIntern")
  createdMistakes  Mistake[] @relation("MistakeFlaggedBy")
  sentMessages     Message[] @relation("MessageFrom")
  receivedMessages Message[] @relation("MessageTo")
  questions        Question[]
  replies          Reply[]
  daySessions      DaySession[]
  auditLogs        AuditLog[]
  settingsUpdated  SystemSetting[]
  flagsReviewed    ContentFlag[]
  calendarMarkers  UserCalendarMarker[]

  @@index([role])
  @@index([techLeadId])
  @@index([organizationId])
  @@index([organizationId, role])
}

model Project {
  id          String       @id @default(uuid())
  organizationId String
  name        String
  description String
  githubUrl   String?
  techStack   String[]
  ownerId     String
  screenshots String[]     @default([])
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  assignedTechLeadIds String[] @default([])
  assignedInternIds String[] @default([])
  createdAt   DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner       User         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  dailyLogs   DailyLog[]

  @@index([ownerId])
  @@index([status])
  @@index([startDate])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([endDate])
}

model DailyLog {
  id            String     @id @default(uuid())
  organizationId String
  internId      String
  projectId     String
  summary       String
  technologies  String[]
  changes       String
  screenshotUrl String?
  githubUrl     String
  date          String     // YYYY-MM-DD
  status        String     @default("submitted") // submitted or reviewed
  isHidden      Boolean    @default(false)
  createdAt     DateTime   @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intern        User       @relation(fields: [internId], references: [id], onDelete: Cascade)
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  marks         Mark[]
  mistakes      Mistake[]

  @@index([internId])
  @@index([projectId])
  @@index([date])
  @@index([isHidden])
  @@index([organizationId])
  @@index([organizationId, internId, date])
}

model Task {
  id           String       @id @default(uuid())
  organizationId String
  assignedToId String
  assignedById String
  title        String
  description  String
  dueDate      String       // YYYY-MM-DD
  priority     TaskPriority
  status       TaskStatus   @default(TODO)
  startedAt    String?      // ISO datetime when intern started the task
  completedAt  String?      // YYYY-MM-DD
  score        Int?
  comment      String?
  blockers     String?
  prLink       String?
  selfScore    Int?
  selfComment  String?
  completedDescription String?
  pendingAcceptance   Boolean   @default(false)
  acceptedAt          DateTime?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy   User         @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  marks        Mark[]

  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId])
  @@index([assignedToId, status])
  @@index([priority])
  @@index([organizationId, assignedToId, status])
}

model Mark {
  id            String    @id @default(uuid())
  organizationId String
  internId      String
  givenById     String
  relatedLogId  String?
  relatedTaskId String?
  score         Int
  comment       String?
  date          String    // YYYY-MM-DD
  createdAt     DateTime  @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intern        User      @relation("MarkIntern", fields: [internId], references: [id], onDelete: Cascade)
  givenBy       User      @relation("MarkGivenBy", fields: [givenById], references: [id], onDelete: Cascade)
  relatedLog    DailyLog? @relation(fields: [relatedLogId], references: [id], onDelete: Cascade)
  relatedTask   Task?     @relation(fields: [relatedTaskId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([givenById])
  @@index([relatedLogId])
  @@index([relatedTaskId])
  @@index([organizationId])
  @@index([internId, date])
  @@index([organizationId, internId, date])
}

model Mistake {
  id           String          @id @default(uuid())
  organizationId String
  internId     String
  flaggedById  String
  relatedLogId String
  note         String
  severity     MistakeSeverity
  date         String          // YYYY-MM-DD
  resolved     Boolean         @default(false)
  createdAt    DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intern       User            @relation("MistakeIntern", fields: [internId], references: [id], onDelete: Cascade)
  flaggedBy    User            @relation("MistakeFlaggedBy", fields: [flaggedById], references: [id], onDelete: Cascade)
  relatedLog   DailyLog        @relation(fields: [relatedLogId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([flaggedById])
  @@index([relatedLogId])
  @@index([organizationId])
  @@index([internId, resolved])
  @@index([date])
  @@index([internId, date, resolved])
}

model Message {
  id        String   @id @default(uuid())
  organizationId String
  fromId    String
  toId      String
  content   String
  read      Boolean  @default(false)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  from      User     @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@index([isHidden])
  @@index([organizationId])
  @@index([read])
  @@index([toId, isHidden, createdAt])
}

model Question {
  id        String   @id @default(uuid())
  organizationId String
  internId  String
  title     String
  content   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intern    User     @relation(fields: [internId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@index([internId])
  @@index([isHidden])
  @@index([organizationId])
  @@index([organizationId, internId, createdAt])
}

model Reply {
  id         String   @id @default(uuid())
  organizationId String
  questionId String
  authorId   String
  content    String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([authorId])
  @@index([isHidden])
  @@index([organizationId])
  @@index([questionId, createdAt])
}

model DaySession {
  id           String   @id @default(uuid())
  organizationId String
  internId     String
  date         String   // YYYY-MM-DD
  startedAt    String
  endedAt      String?
  status       String   @default("active")
  todayProject String?
  todayPlan    String?
  questions    String?
  gitLink      String?
  endJournal   String?
  createdAt    DateTime @default(now())
  
  earlyExitRequested Boolean @default(false)
  earlyExitReason    String?
  earlyExitApproved  Boolean @default(false)
  missedFinalJournal Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intern       User       @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([date])
  @@index([organizationId])
  @@index([organizationId, date, status])
  @@index([internId, date, status])
}

model AuditLog {
  id        String    @id @default(uuid())
  organizationId String?
  userId    String
  action    String
  targetType String?
  details   String?
  timestamp DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([targetType])
  @@index([action])
  @@index([organizationId])
  @@index([userId, timestamp, action])
}

model SystemSetting {
  id        String   @id @default(uuid())
  organizationId String
  key       String
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updater    User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([organizationId])
  @@unique([organizationId, key])
}

model UserCalendarMarker {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  date           String    // YYYY-MM-DD
  isAvailable    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([organizationId])
  @@unique([userId, date])
}

model ContentFlag {
  id          String   @id @default(uuid())
  organizationId String
  userId      String
  contentId   String
  contentType String
  reason      String
  status      String   @default("pending")
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentId])
  @@index([status])
  @@index([organizationId])
  @@index([organizationId, status, createdAt])
}
