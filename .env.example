# App URL
APP_URL=http://localhost:3000

# Database (Supabase-hosted PostgreSQL used as the database engine)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project (used for PostgreSQL storage engine + optional Storage/Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Custom auth: JWT session cookie signing (min 32 chars, use `openssl rand -base64 48`)
SESSION_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
SESSION_MAX_AGE=28800

# Super Admin Bootstrap
SUPERADMIN_EMAIL=superadmin@company.com
SUPERADMIN_PASSWORD=ChangeMeNow!
